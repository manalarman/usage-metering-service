# Copy to .env to override defaults used by docker-compose.yml (all values below are the defaults).

# PostgreSQL credentials / database (used by the db container and to build the API's DATABASE_URL)
POSTGRES_USER=metering
POSTGRES_PASSWORD=metering
POSTGRES_DB=metering
# Host port for PostgreSQL (55432 avoids clashing with a locally installed Postgres on 5432)
POSTGRES_HOST_PORT=55432

# Host port for the API
API_HOST_PORT=3000

# Operator secret for POST /v1/admin/accounts (account provisioning). CHANGE THIS outside local dev.
# An empty value disables provisioning entirely.
ADMIN_TOKEN=dev-admin-token-change-me

# API connection pool size
DB_POOL_MAX=20
# Log one line per HTTP request
LOG_REQUESTS=false

# --- Only for running the API / tests / client outside Docker ---
# DATABASE_URL=postgres://metering:metering@localhost:55432/metering
# TEST_DATABASE_URL=postgres://metering:metering@localhost:55432/metering_test
# API_URL=http://localhost:3000
# PORT=3000
# AUTO_MIGRATE=true
