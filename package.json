{
  "name": "usage-metering-service",
  "version": "1.0.0",
  "description": "Usage Metering and Quota Service: account + user plans, monthly allowances, idempotent consumption",
  "private": true,
  "license": "MIT",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/db/cli.ts",
    "client": "tsx src/client/cli.ts",
    "demo": "tsx src/client/cli.ts demo",
    "test": "vitest run",
    "verify:consistency": "tsx scripts/verify-consistency.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
